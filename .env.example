# Supabase Configuration
# ======================
# 
# INSTRUCTIONS:
# 1. Get these values from https://app.supabase.com/project/_/settings/api
# 2. Copy this file to .env (or update lib/supabase/supabase_config.dart directly)
# 3. Replace YOUR_* placeholders with actual values
# 4. Never commit your actual credentials to version control!

# Your Supabase Project URL
# Example: https://abcdefghijklm.supabase.co
SUPABASE_URL=YOUR_SUPABASE_URL

# Your Supabase Anon/Public Key
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ======================
# Where to find these values:
# 1. Go to your Supabase project dashboard
# 2. Click Settings (gear icon) in the sidebar
# 3. Click "API" under Project Settings
# 4. Copy "Project URL" and "anon public" key
# ======================
